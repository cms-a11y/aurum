
{% comment %}
  Sort - Accordion with Radio Buttons

  Usage:
  {% render 'sort', product_list: collection %}
  {% render 'sort', product_list: search %}
{% endcomment %}

{%- render 'adastra' with '/src/styles/sort.scss' -%}

{%- assign sort_by = product_list.sort_by | default: product_list.default_sort_by -%}

<div class="product-filters__form-item filter-accordion-item sort-accordion">

  <button
    type="button"
    class="product-filters__form-title"
    data-filter-accordion-trigger
    aria-expanded="false"
  >
    <span>{{ 'collections.sorting.title' | t }}</span>
    {%- render 'icons', icon: 'arrow-down' -%}
  </button>

  <div
    class="product-filters__form-content"
    data-filter-accordion-panel
    style="height: 0; overflow: hidden;"
  >
    <!-- Keep your existing sort radio buttons here -->
    <div class="sort sort--radio">
      <fieldset class="sort__fieldset">

        <legend class="visually-hidden">
          {{ 'collections.sorting.title' | t }}
        </legend>

        <div class="sort__radio-list">

          {%- for option in product_list.sort_options -%}

            <div class="sort__radio-item">

              <input
                type="radio"
                class="sort__radio"
                id="Sort-{{ forloop.index }}"
                name="sort_by"
                value="{{ option.value | escape }}"
                {% if option.value == sort_by %}checked{% endif %}
              >

              <label
                class="sort__radio-label"
                for="Sort-{{ forloop.index }}"
              >
                <span class="sort__radio-indicator"></span>
                <span>{{ option.name | escape }}</span>
              </label>

            </div>

          {%- endfor -%}

        </div>
      </fieldset>
    </div>
  </div>
</div>

<script>
  document.addEventListener('change', function(event) {

    if (!event.target.matches('.sort--radio input[name="sort_by"]')) {
      return;
    }

    const form = event.target.closest('form');

    if (form) {
      if (form.requestSubmit) {
        form.requestSubmit();
      } else {
        form.submit();
      }
    }

  });
</script>

<style>
  /* Sort accordion */
  .sort-accordion {
    border-bottom: 1px solid #e5e5e5;
  }

  .product-filters__form-title {
   width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
  background: transparent;
  border: 0;
  text-align: left;
  cursor: pointer;
  font-size: 26px;
  color: #70452f;
font-family: 'PT Serif';
  }

  .sort-accordion .product-filters__form-title svg {
    width: 17px;
    height: 17px;
    transition: transform 0.3s ease;
  }

  .sort-accordion .product-filters__form-title[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .sort-accordion .sort__fieldset {
    border: 0;
    padding: 0 0 18px;
    margin: 0;
    min-width: 0;
  }

  .sort-accordion .sort__radio-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sort-accordion .sort__radio-item {
    display: flex;
    align-items: center;
  }

  .sort-accordion .sort__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .sort-accordion .sort__radio-label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 14px;
    line-height: 1.5;
  }

  .sort-accordion .sort__radio-indicator {
    width: 17px;
    height: 17px;
    min-width: 17px;
    border: 1px solid #999;
    border-radius: 50%;
    position: relative;
  }

  .sort-accordion .sort__radio:checked + .sort__radio-label
  .sort__radio-indicator {
    border-color: #75162D;
  }

  .sort-accordion .sort__radio:checked + .sort__radio-label
  .sort__radio-indicator::after {
    content: "";
    position: absolute;
    inset: 3px;
    background: #75162D;
    border-radius: 50%;
  }

  .sort-accordion .sort__radio:focus-visible + .sort__radio-label {
    outline: 2px solid #75162D;
    outline-offset: 4px;
  }
</style>