<script>

(function () {
  const selector = [
    'main img',
    '.shopify-section img',
    'footer img'
  ].join(',');

  const excluded = [
    '.header',
    '.header__logo',
    '.logo',
    '.icon',
    '.payment-icons',
    '.product-card__label',
    '.need-animate',
    '.js-animate',
    '.global-image-skip'
  ].join(',');

  let observer;

  function initGlobalImageAnimations(scope = document) {
    const images = [];

    if (scope instanceof HTMLImageElement) {
      images.push(scope);
    }

    if (scope.querySelectorAll) {
      images.push(...scope.querySelectorAll(selector));
    }

    images.forEach((img) => {
      if (
        img.closest(excluded) ||
        img.classList.contains('global-image-reveal') ||
        img.getAttribute('fetchpriority') === 'high'
      ) {
        return;
      }

      if (
        img.getAttribute('width') === '1' ||
        img.getAttribute('height') === '1'
      ) {
        return;
      }

      img.classList.add('global-image-reveal');

      if (observer) {
        observer.observe(img);
      } else {
        img.classList.add('is-image-visible');
      }
    });
  }

  function initialize() {
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    ) {
      return;
    }

    observer = new IntersectionObserver((entries, observerInstance) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-image-visible');
          observerInstance.unobserve(entry.target);
        }
      });
    }, {
      rootMargin: '0px 0px -40px 0px',
      threshold: 0.05
    });

    // Enable CSS only after observer is ready
    document.documentElement.classList.add(
      'global-image-animation-ready'
    );

    initGlobalImageAnimations();

    // Shopify theme editor support
    document.addEventListener('shopify:section:load', (event) => {
      initGlobalImageAnimations(event.target);
    });

    // Dynamically added images
    const mutationObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.addedNodes.forEach((node) => {
          if (node.nodeType === 1) {
            initGlobalImageAnimations(node);
          }
        });
      });
    });

    mutationObserver.observe(document.body, {
      childList: true,
      subtree: true
    });

    window.themeCore = window.themeCore || {};
    window.themeCore.initGlobalImageAnimations =
      initGlobalImageAnimations;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
})();

</script>