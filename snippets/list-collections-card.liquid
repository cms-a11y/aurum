{% comment %}
  ------------------------------------------------------------------------------
  Snippet: List collections card
  - collection: Collection object (required)
  - image: image object
  - text_alignment: text aligment position
  - show_products_count: boolean, show/hide products count,
  - is_lazy: boolean, enable lazy-load
  - item_size: image size class, small or large
  ------------------------------------------------------------------------------
{% endcomment %}

{%- render 'adastra' with '/src/styles/list-collections-card.scss' -%}

{%- assign min = 1 -%}
{%- assign max = 6 -%}
{%- assign diff = max | minus: min -%}

{%- assign size_width_375 = 163 -%}
{%- assign size_height_375 = size_width_375 -%}
{%- assign size_width_375_2x = size_width_375 | times: 2 -%}
{%- assign size_height_375_2x = size_height_375 | times: 2 -%}

{%- assign size_width_420 = 186 -%}
{%- assign size_height_420 = size_width_420 -%}
{%- assign size_width_420_2x = size_width_420 | times: 2 -%}
{%- assign size_height_420_2x = size_height_420 | times: 2 -%}

{%- assign size_width_767 = 360 -%}
{%- assign size_height_767 = size_width_767 -%}
{%- assign size_width_767_2x = size_width_767 | times: 2 -%}
{%- assign size_height_767_2x = size_height_767 | times: 2 -%}

{%- assign size_width_991 = 309 -%}
{%- assign size_height_991 = size_width_991 -%}
{%- assign size_width_991_2x = size_width_991 | times: 2 -%}
{%- assign size_height_991_2x = size_height_991 | times: 2 -%}

{%- assign size_width_1500 = 479 -%}
{%- assign size_height_1500 = size_width_1500 -%}
{%- assign size_width_1500_2x = size_width_1500 | times: 2 -%}
{%- assign size_height_1500_2x = size_height_1500 | times: 2 -%}

{%- assign size_width = 619 -%}
{%- assign size_height = size_width -%}
{%- assign size_width_2x = size_width | times: 2 -%}
{%- assign size_height_2x = size_height | times: 2 -%}

{%- if collections_grid == "featured" -%}
	{%- if item_size == 'portrait' -%}
		{%- assign size_width_375 = 163 -%}
		{%- assign size_height_375 = 250 -%}
		{%- assign size_width_375_2x = size_width_375 | times: 2 -%}
		{%- assign size_height_375_2x = size_height_375 | times: 2 -%}

		{%- assign size_width_420 = 186 -%}
		{%- assign size_height_420 = 284 -%}
		{%- assign size_width_420_2x = size_width_420 | times: 2 -%}
		{%- assign size_height_420_2x = size_height_420 | times: 2 -%}

		{%- assign size_width_767 = 360 -%}
		{%- assign size_height_767 = 550 -%}
		{%- assign size_width_767_2x = size_width_767 | times: 2 -%}
		{%- assign size_height_767_2x = size_height_767 | times: 2 -%}

		{%- assign size_width_991 = 228 -%}
		{%- assign size_height_991 = 325 -%}
		{%- assign size_width_991_2x = size_width_991 | times: 2 -%}
		{%- assign size_height_991_2x = size_height_991 | times: 2 -%}

		{%- assign size_width_1500 = 355 -%}
		{%- assign size_height_1500 = 496 -%}
		{%- assign size_width_1500_2x = size_width_1500 | times: 2 -%}
		{%- assign size_height_1500_2x = size_height_1500 | times: 2 -%}

		{%- assign size_width = 460 -%}
		{%- assign size_height = 642 -%}
		{%- assign size_width_2x = size_width | times: 2 -%}
		{%- assign size_height_2x = size_height | times: 2 -%}
	{%- else -%}
		{%- assign size_width_375 = 343 -%}
		{%- assign size_height_375 = 250 -%}
		{%- assign size_width_375_2x = size_width_375 | times: 2 -%}
		{%- assign size_height_375_2x = size_height_375 | times: 2 -%}

		{%- assign size_width_420 = 388 -%}
		{%- assign size_height_420 = 283 -%}
		{%- assign size_width_420_2x = size_width_420 | times: 2 -%}
		{%- assign size_height_420_2x = size_height_420 | times: 2 -%}

		{%- assign size_width_767 = 735 -%}
		{%- assign size_height_767 = 536 -%}
		{%- assign size_width_767_2x = size_width_767 | times: 2 -%}
		{%- assign size_height_767_2x = size_height_767 | times: 2 -%}

		{%- assign size_width_991 = 472 -%}
		{%- assign size_height_991 = 344 -%}
		{%- assign size_width_991_2x = size_width_991 | times: 2 -%}
		{%- assign size_height_991_2x = size_height_991 | times: 2 -%}

		{%- assign size_width_1500 = 726 -%}
		{%- assign size_height_1500 = 529 -%}
		{%- assign size_width_1500_2x = size_width_1500 | times: 2 -%}
		{%- assign size_height_1500_2x = size_height_1500 | times: 2 -%}

		{%- assign size_width = 936 -%}
		{%- assign size_height = 682 -%}
		{%- assign size_width_2x = size_width | times: 2 -%}
		{%- assign size_height_2x = size_height | times: 2 -%}
	{%- endif -%}
{%- elsif collections_grid == "portrait" -%}
	{%- assign size_height_375 = 250 -%}
	{%- assign size_height_375_2x = size_height_375 | times: 2 -%}

	{%- assign size_height_420 = 284 -%}
	{%- assign size_height_420_2x = size_height_420 | times: 2 -%}

	{%- assign size_height_767 = 550 -%}
	{%- assign size_height_767_2x = size_height_767 | times: 2 -%}

	{%- assign size_height_991 = 441 -%}
	{%- assign size_height_991_2x = size_height_991 | times: 2 -%}

	{%- assign size_height_1500 = 668 -%}
	{%- assign size_height_1500_2x = size_height_1500 | times: 2 -%}

	{%- assign size_height = 864 -%}
	{%- assign size_height_2x = size_height | times: 2 -%}
{%- endif -%}

<a
  class="focus-visible-outline list-collections-card {% if text_alignment != 'left' %}list-collections-card--{{ text_alignment }}{% endif %}"
  {% if collection != blank %}
    href="{{- collection.url -}}"
    aria-label="{{- 'collections.general.collection_card_link_aria_label' | t: title: collection.title | escape -}}"
  {% endif %}
  {% if collection == blank %}role="link" aria-disabled="true"{% endif %}
>
	<span class="list-collections-card__image-wrapper list-collections-card__image-wrapper--{{- item_size }}">
		{% if image != blank %}
			{%- capture img_focal -%}
				--img-desktop-pos: {{ image.presentation.focal_point }};
			{%- endcapture -%}

			<picture class="{% if is_lazy %}lazy{% endif %} no-js-hidden">
				<source
					{% if is_lazy %}
						data-srcset="{{ image | image_url: width: size_width_375, height: size_height_375, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_375, height: size_height_2x_375, crop: 'center' }} 2x"
						srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
					{% else %}
						srcset="{{ image | image_url: width: size_width_375, height: size_height_375, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_375, height: size_height_2x_375, crop: 'center' }} 2x"
					{% endif %}
					media="(max-width: 375px)"
				>

				<source
					{% if is_lazy %}
						data-srcset="{{ image | image_url: width: size_width_420, height: size_height_420, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_420, height: size_height_2x_420, crop: 'center' }} 2x"
						srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
					{% else %}
						srcset="{{ image | image_url: width: size_width_420, height: size_height_420, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_420, height: size_height_2x_420, crop: 'center' }} 2x"
					{% endif %}
					media="(max-width: 420px)"
				>

				<source
					{% if is_lazy %}
						data-srcset="{{ image | image_url: width: size_width_767, height: size_height_767, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_767, height: size_height_2x_767, crop: 'center' }} 2x"
						srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
					{% else %}
						srcset="{{ image | image_url: width: size_width_767, height: size_height_767, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_767, height: size_height_2x_767, crop: 'center' }} 2x"
					{% endif %}
					media="(max-width: 767px)"
				>

				<source
					{% if is_lazy %}
						data-srcset="{{ image | image_url: width: size_width_991, height: size_height_991, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_991, height: size_height_2x_991, crop: 'center' }} 2x"
						srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
					{% else %}
						srcset="{{ image | image_url: width: size_width_991, height: size_height_991, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_991, height: size_height_2x_991, crop: 'center' }} 2x"
					{% endif %}
					media="(max-width: 991px)"
				>

				<source
					{% if is_lazy %}
						data-srcset="{{ image | image_url: width: size_width_1500, height: size_height_1500, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_1500, height: size_height_2x_1500, crop: 'center' }} 2x"
						srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
					{% else %}
						srcset="{{ image | image_url: width: size_width_1500, height: size_height_1500, crop: 'center' }} 1x, {{ image | image_url: width: size_width_2x_1500, height: size_height_2x_1500, crop: 'center' }} 2x"
					{% endif %}
					media="(max-width: 1500px)"
				>

				<img class="list-collections-card__image"
					{% if is_lazy %}
						src="{{ image | image_url: width: 10 }}"
						srcset="{{ image | image_url: width: 10 }}"
						data-src="{{ image | image_url: width: size_width, height: size_height, crop: 'center' }}"
						data-srcset="{{ image | image_url: width: size_width, height: size_height, crop: 'center' }} 1x,
									 {{ image | image_url: width: size_width_2x, height: size_height_2x, crop: 'center' }} 2x"
					{% else %}
						src="{{ image | image_url: width: size_width, height: size_height, crop: 'center' }}"
						srcset="{{ image | image_url: width: size_width, height: size_height, crop: 'center' }} 1x,
								{{ image | image_url: width: size_width_2x, height: size_height_2x, crop: 'center' }} 2x"
					{% endif %}
					 alt="{{ image.alt | escape }}"
					{% if img_focal != blank %}
						style="{{ img_focal }}"
					{% endif %}
				>
			</picture>
		{% else %}
      		{%- assign random_number = "now" | date: "%N" | modulo: diff | plus: min -%}
      		{%- assign placeholder_svg_name = 'collection-' | append: random_number -%}

			<span aria-hidden="true">
				{{- placeholder_svg_name | placeholder_svg_tag: 'list-collections-card__image list-collections-card__image--placeholder' -}}
			</span>
    	{% endif %}
	</span>

  <div class="list-collections-card__header">
    <div class="list-collections-card__title h4" aria-hidden="true">
      {%- if collection == blank -%}
        {{ 'sections.collection_list.card_title' | t }}
      {%- else -%}
        {{- collection.title -}}
      {%- endif -%}
    </div>

    {% if show_products_count %}
      {% assign one_product_label = 'sections.collection_list.one_product' | t %}
      {% assign many_product_label = 'sections.collection_list.many_products' | t %}

      <div class="list-collections-card__count">
        {%- if collection == blank -%}
          0 {{ many_product_label }}
        {%- else -%}
          {{ collection.all_products_count }} {{ collection.all_products_count | pluralize: one_product_label, many_product_label }}
        {%- endif -%}
      </div>
    {% endif %}
  </div>
</a>

