{% comment %}
------------------------------------------------------------------------------
  Snippet: Product Form
  ---------------------------
  Use blocks:
  	- "Vendor and SKU"
	- "Title"
	- "Options"
	- "Quantity"
	- "Price"
	- "Add to cart"
	- "Pickup availability"
	- "Sales point"
	- "Notify me"
	- "Custom liquid" 
------------------------------------------------------------------------------
{% endcomment %}
{% assign is_preset = false %}

{% if product == blank %}
	{% assign is_preset = true %}
{% endif %}

{%- assign show_sticky_add_to_cart = section.settings.show_sticky_add_to_cart -%}

{% assign use_variant = false %}

{% if product.variants.size > 1 %}
	{% assign use_variant = true %}
{% endif %}

{% if blocks.size > 0 %}
	{% comment %}
			The repeated content inside the <form> and <div> tags is there for a reason.
			Liquid "form" tag cannot be designated as separately opening and separately closing.
			If the Liquid "form" tag is replaced with an HTML tag,
			then we will not be able to pass the "form" object to the "Price" snippet.
			There, the "form" object is used to render "payment_terms"
			Please fix this issue before changing anything.
		{% endcomment %}
		
	{% if product != blank %}
		{% form 'product',
			product,
			data-js-product-form: true,
			class: 'product-form js-product-sticky-container',
			data-section-id: section.id,
			data-enable-history-state: enable_history_state,
			data-template: product_template
		%}
		 {% render "breadcrumbs" %}

			{% include 'product-json' %}

			{% if product.template_suffix == 'pre-order' %}
				<input type="hidden" name="properties[_Pre-order]" value="true">
			{% endif %}

			{% for block in blocks  %}
				{% case block.type %}
					{% when 'badges' %}
						{% render 'product-badges', block: block, product: product, is_preset: is_preset %}
					{% when 'vendor' %}
						{% render 'product-vendor-sku', block: block, product: product, is_preset: is_preset %}
						{% when 'appointment_box' %}

  <div
    class="product-appointment-box"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <h3 class="product-appointment-box__heading">
        {{ block.settings.heading | escape }}
      </h3>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="product-appointment-box__description">
        {{ block.settings.description }}
      </div>
    {% endif %}

	{%- capture request_quote_url -%}
	{%- render 'whatsapp-link', product: product -%}
{%- endcapture -%}
{%- assign request_quote_url = request_quote_url | strip -%}

	{% unless is_preset %}
			<a
				href="{{ request_quote_url }}"
				class="button button--primary product-description__quote-button"
				target="_blank"
				rel="noopener noreferrer"
			>
				{{ 'products.product.request_quote' | t }}
			</a>
		{% endunless %}

    {% if block.settings.show_button %}
      <a
        href="{{ block.settings.button_url | default: appointment_url }}"
        class="button button--block button--secondary-border product-add-to-cart__appointment-button"
      >
        {{ block.settings.button_label | escape }}
      </a>
    {% endif %}

	
  </div>


{% when 'product_specifications' %}
 {%- assign metal_value = product.metafields.custom.metal.value -%}
{%- assign gemstone_value = product.metafields.custom.tanzanite_karat_size.value -%}
{%- assign setting_value = product.metafields.custom.setting.value -%}
{%- assign size_value = product.metafields.custom.ring_size.value -%}
{%- assign weight_value = product.metafields.custom.weight.value -%}

  <div
    class="product-specifications"
    id="ProductSpecifications-{{ section.id }}-{{ block.id }}"
    style="
      --spec-bg: {{ block.settings.background_color }};
      --spec-padding-top: {{ block.settings.padding_top }}px;
      --spec-padding-bottom: {{ block.settings.padding_bottom }}px;
      --spec-desktop-columns: {{ block.settings.desktop_columns }};
      --spec-mobile-columns: {{ block.settings.mobile_columns }};
    "
    {{ block.shopify_attributes }}
  >
    <div class="product-specifications__grid">

		{% if metal_value != blank %}
        <div class="product-specifications__item">
          <div class="product-specifications__icon">
           <svg viewBox="0 0 40 40" fill="none" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
  <circle cx="20" cy="20" r="14"/>
</svg>
          </div>
          <div class="product-specifications__subtitle">METAL</div>
          <div class="product-specifications__title">
            {{ metal_value | escape }}
          </div>
        </div>
      {% endif %}

      {% if gemstone_value != blank %}
        <div class="product-specifications__item">
          <div class="product-specifications__icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
  <path d="M12 8H28L36 17L20 34L4 17L12 8Z"/>
  <path d="M4 17H36M12 8L20 34L28 8M12 8L16 17L20 34M28 8L24 17L20 34"/>
</svg>
          </div>
          <div class="product-specifications__subtitle">GEMSTONE</div>
          <div class="product-specifications__title">
            {{ gemstone_value | escape }}
          </div>
        </div>
      {% endif %}

	  {% if setting_value != blank %}
        <div class="product-specifications__item">
          <div class="product-specifications__icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
  <circle cx="20" cy="20" r="14"/>
  <path d="M20 11L22.8 17L29 18L24.5 22.5L25.5 29L20 26L14.5 29L15.5 22.5L11 18L17.2 17L20 11Z"/>
</svg>
          </div>
          <div class="product-specifications__subtitle">SETTING</div>
          <div class="product-specifications__title">
            {{ setting_value | escape }}
          </div>
        </div>
      {% endif %}

	  {% if size_value != blank %}
        <div class="product-specifications__item">
          <div class="product-specifications__icon">
          <svg viewBox="0 0 40 40" fill="none" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
  <path d="M7 12L12 7L33 28L28 33L7 12Z"/>
  <path d="M12 12L16 8M17 17L21 13M22 22L26 18"/>
</svg>
          </div>
          <div class="product-specifications__subtitle">SIZE</div>
          <div class="product-specifications__title">
            {{ size_value | escape }}
          </div>
        </div>
      {% endif %}

      {% if weight_value != blank %}
        <div class="product-specifications__item">
          <div class="product-specifications__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3V21M5 6H19M7 6L3 16H11L7 6ZM17 6L13 16H21L17 6Z"/>
            </svg>
          </div>
          <div class="product-specifications__subtitle">WEIGHT</div>
          <div class="product-specifications__title">
            {{ weight_value | escape }}
          </div>
        </div>
      {% endif %}

      

    </div>
  </div>

  <style>
    #ProductSpecifications-{{ section.id }}-{{ block.id }} {
      background: var(--spec-bg);
      padding-top: var(--spec-padding-top);
      padding-bottom: var(--spec-padding-bottom);
      width: 100%;
    }

    #ProductSpecifications-{{ section.id }}-{{ block.id }}
    .product-specifications__grid {
      display: grid;
      grid-template-columns: repeat(var(--spec-desktop-columns), minmax(0, 1fr));
      gap: 20px;
      width: 100%;
    }

    #ProductSpecifications-{{ section.id }}-{{ block.id }}
    .product-specifications__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      min-width: 0;
    }

    #ProductSpecifications-{{ section.id }}-{{ block.id }}
    .product-specifications__icon {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: #f0e6d2;
      color: #80142e;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    #ProductSpecifications-{{ section.id }}-{{ block.id }}
    .product-specifications__icon svg {
      width: 32px;
      height: 32px;
    }

    #ProductSpecifications-{{ section.id }}-{{ block.id }}
    .product-specifications__subtitle {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #94735e;
      margin-bottom: 10px;
    }

    #ProductSpecifications-{{ section.id }}-{{ block.id }}
    .product-specifications__title {
      font-size: 15px;
      font-weight: 600;
      line-height: 1.5;
      color: #241616;
    }

    @media screen and (max-width: 767px) {
      #ProductSpecifications-{{ section.id }}-{{ block.id }}
      .product-specifications__grid {
        grid-template-columns: repeat(var(--spec-mobile-columns), minmax(0, 1fr));
        gap: 24px 12px;
      }

      #ProductSpecifications-{{ section.id }}-{{ block.id }}
      .product-specifications__icon {
        width: 65px;
        height: 65px;
      }

      #ProductSpecifications-{{ section.id }}-{{ block.id }}
      .product-specifications__icon svg {
        width: 28px;
        height: 28px;
      }

      #ProductSpecifications-{{ section.id }}-{{ block.id }}
      .product-specifications__title {
        font-size: 13px;
      }
    }
  </style>

					{% when 'title' %}
						{% render 'product-title', block: block, product: product, is_preset: is_preset %}
					{% when 'description' %}
						{% render 'product-description', block: block, product: product, is_preset: is_preset %}
					{% when 'product_combination' %}
						{% render 'product-combination', block: block, product: product %}
					{% when 'options' %}
						{% render 'product-options', section: section, block: block, product: product %}
					{% when 'quantity' %}
						{% render 'product-quantity', block: block, product: product %}
					{% when 'price' %}
						{%- render 'price',
							product: product,
							use_variant: use_variant,
							show_unit_price: settings.is_show_unit_price,
							currency_code_enabled: settings.is_currency_code_enabled,
							price_class: 'product-price h4',
							hide_from_price: true,
							show_taxes_included: section.settings.show_taxes_included,
							show_pay_installments: section.settings.show_pay_installments,
							form: form,
							show_volume_pricing_info: true,
							block: block
						-%}
					{% when 'add_to_cart' %}
						{% render 'product-add-to-cart',
							form: form,
							section: section,
							blocks: blocks,
							block: block,
							use_variant: use_variant,
							show_sticky_add_to_cart: show_sticky_add_to_cart,
							product: product
						%}
					{% when 'pickup_availability' %}
						{% render 'product-pickup-availability', product: product, block: block, section_id: section.id %}
					{% when 'drawers' %}
						{% render 'product-drawers', product: product, block: block, section: section %}
					{% when 'complementary' %}
						{% render 'product-complementary', product: product, block: block, section_id: section.id %}
					{% when 'sales_point' %}
						{% render 'product-sales-point', block: block %}
					{% when 'inventory_status' %}
						{% render 'product-inventory-status', block: block, product: product %}
					{% when 'text' %}
						{% render 'product-text', block: block %}
					{% when 'option_accuracy' %}
						{% render 'product-option-accuracy', block: block %}
					{% when 'progress_range' %}
						{% render 'product-progress-range', block: block %}
					{% when 'discount' %}
						{% render 'product-discount', block: block %}
					{% when 'custom_liquid' %}
						{% render 'product-custom-liquid', block: block %}
					{% when 'notify_me' %}
						{% render 'product-notify-me-button', block: block, section_id: section.id %}
					{% when 'ask_question' %}
						{% render 'product-ask-question-button', block: block, section_id: section.id %}
					{% when 'gift_wrap_product' %}
						{% render 'product-gift-box', product: product, block: block %}
					{% when 'countdown_timer' %}
						{%- assign text 						= block.settings.text -%}
						{%- assign icon 						= block.settings.icon -%}
						{%- assign text_color 					= block.settings.text_color | default: "#000000" -%}
						{%- assign timer_text_color 			= block.settings.timer_text_color  | default: "#ffffff" -%}
						{%- assign timer_background_color 		= block.settings.timer_background_color  | default: "#000000" -%}
						{%- assign offset_top_desktop 			= block.settings.offset_top_desktop -%}
						{%- assign offset_bottom_desktop 		= block.settings.offset_bottom_desktop -%}
						{%- assign offset_top_mobile 			= block.settings.offset_top_mobile -%}
						{%- assign offset_bottom_mobile 		= block.settings.offset_bottom_mobile -%}

						{% render 'product-countdown-timer',
							product: product,
							text: text,
							icon: icon,
							text_color: text_color,
							timer_text_color: timer_text_color,
							timer_background_color: timer_background_color,
							offset_top_desktop: offset_top_desktop,
							offset_bottom_desktop: offset_bottom_desktop,
							offset_top_mobile: offset_top_mobile,
							offset_bottom_mobile: offset_bottom_mobile
						%}
					{% when 'custom_field' %}
						{% render 'product-custom-field', block: block %}
					{% when 'socials' %}
						{% render 'product-share-buttons', block: block, product: product, section_id: section.id %}
					{% when 'benefits' %}
						{% render 'product-benefits', block: block %}
					{% else %}
						{% render block %}
				{% endcase %}
			{% endfor %}
		{% endform %}
	{% else %}
		<div
			id="product_form_{{- product.id -}}"
			class="shopify-product-form product-form js-product-sticky-container"
			data-section-id="{{- section.id -}}"
		>
			{% for block in blocks  %}
				{% case block.type %}
					{% when 'badges' %}
						{% render 'product-badges', block: block, product: product, is_preset: is_preset %}
					{% when 'vendor' %}
						{% render 'product-vendor-sku', block: block, product: product, is_preset: is_preset %}
					{% when 'title' %}
						{% render 'product-title', block: block, product: product, is_preset: is_preset %}
					{% when 'options' %}
						{% render 'product-options', section: section, block: block, product: product %}
					{% when 'quantity' %}
						{% render 'product-quantity', block: block, product: product %}
					{% when 'price' %}
						{%- render 'price',
							product: product,
							use_variant: use_variant,
							show_unit_price: settings.is_show_unit_price,
							currency_code_enabled: settings.is_currency_code_enabled,
							price_class: 'product-price h4',
							hide_from_price: true,
							show_taxes_included: section.settings.show_taxes_included,
							show_pay_installments: section.settings.show_pay_installments,
							form: form,
							block: block
						-%}
					{% when 'add_to_cart' %}
						{% render 'product-add-to-cart',
							form: form,
							section: section,
							block: block,
							blocks: blocks,
							use_variant: use_variant,
							show_sticky_add_to_cart: show_sticky_add_to_cart,
							product: product
						%}
					{% when 'pickup_availability' %}
						{% render 'product-pickup-availability', product: product, block: block, section_id: section.id %}
					{% when 'drawers' %}
						{% render 'product-drawers', product: product, block: block, section: section %}
					{% when 'custom_liquid' %}
						{% render 'product-custom-liquid', block: block %}
					{% when 'socials' %}
						{% render 'product-share-buttons', block: block, product: product, section_id: section.id %}
					{% else %}
						{% render block %}
				{% endcase %}
			{% endfor %}
		</div>
	{% endif %}
{% endif %}
