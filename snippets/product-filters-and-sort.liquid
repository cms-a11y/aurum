
{% comment %}
  Product filters and sort
  Uses all product tags from the current collection.
  Supported tag prefixes:
  metal-
  shape-
  carat-
{% endcomment %}

{%- render 'adastra' with '/src/styles/product-filters.scss' -%}

{%- liquid
  assign active_filters_size = 0

  if current_tags
    assign active_filters_size = current_tags.size
  endif

  assign filter_prefixes = 'metal,shape,carat' | split: ','
  assign sorted_collection_tags = collection.all_tags | sort
-%}

<div class="product-filters">

  {% comment %} Filter button {% endcomment %}
  <div class="product-filters__top">
    {% render 'product-filter-button', active_filters_size: active_filters_size %}
  </div>

  {% comment %} Filter drawer {% endcomment %}
  <div class="drawer" id="filterMenuDrawer" role="dialog" aria-labelledby="filterMenuDrawerTitle">

    <div class="drawer__header">
      <h2 id="filterMenuDrawerTitle">Filters</h2>
    </div>

    <div class="drawer__body product-filters__form-body js-filters-body">

      {% comment %} SORT BY - Keep this component only once {% endcomment %}
      <div class="product-filters__form-sort">
        {% render 'sort', product_list: product_list %}
      </div>

      {% comment %} COLLECTION {% endcomment %}
      {% if collection != blank %}
        <div class="product-filters__form-item js-accordion-container">
          <button
            type="button"
            class="product-filters__form-title js-accordion-control"
            aria-expanded="true"
          >
            <span>Collection</span>
            <span class="product-filters__form-icon">+</span>
          </button>

          <div class="product-filters__form-content js-accordion-content">
            <ul class="product-filters__list">
              <li>
                <a href="{{ collection.url }}">
                  {{ collection.title }}
                </a>
              </li>
            </ul>
          </div>
        </div>
      {% endif %}

      {% comment %} DYNAMIC PRODUCT TAG FILTERS {% endcomment %}
      {% if collection != blank and sorted_collection_tags.size > 0 %}

        {% for filter_prefix in filter_prefixes %}

          {% assign prefix_with_dash = filter_prefix | append: '-' %}
          {% assign prefix_length = prefix_with_dash.size %}

          {% assign has_options = false %}

          {% for filter_tag in sorted_collection_tags %}
            {% assign tag_start = filter_tag | slice: 0, prefix_length %}

            {% if tag_start == prefix_with_dash %}
              {% assign has_options = true %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% if has_options %}

            {% case filter_prefix %}
              {% when 'metal' %}
                {% assign filter_title = 'Metal' %}
              {% when 'shape' %}
                {% assign filter_title = 'Shape' %}
              {% when 'carat' %}
                {% assign filter_title = 'Carat' %}
            {% endcase %}

            <div class="product-filters__form-item js-accordion-container">

              <button
                type="button"
                class="product-filters__form-title js-accordion-control"
                aria-expanded="true"
              >
                <span>{{ filter_title }}</span>
                <span class="product-filters__form-icon">+</span>
              </button>

              <div class="product-filters__form-content js-accordion-content">

                <ul class="product-filters__list">

                  {% for filter_tag in sorted_collection_tags %}

                    {% assign tag_start = filter_tag | slice: 0, prefix_length %}

                    {% if tag_start == prefix_with_dash %}

                      {% assign tag_is_active = false %}

                      {% if current_tags contains filter_tag %}
                        {% assign tag_is_active = true %}
                      {% endif %}

                      {% assign tag_label = filter_tag | remove_first: prefix_with_dash | replace: '-', ' ' | capitalize %}

                      {% comment %}
                        Build URL while preserving all other selected tags.
                        If the tag is already selected, remove it.
                        Otherwise, add it.
                      {% endcomment %}

                      {% capture tag_path %}
                        {%- assign tag_separator = '' -%}

                        {%- for selected_tag in current_tags -%}
                          {%- unless selected_tag == filter_tag -%}
                            {{- tag_separator -}}{{- selected_tag | handleize -}}
                            {%- assign tag_separator = '+' -%}
                          {%- endunless -%}
                        {%- endfor -%}

                        {%- unless tag_is_active -%}
                          {{- tag_separator -}}{{- filter_tag | handleize -}}
                        {%- endunless -%}
                      {% endcapture %}

                      {% assign tag_path = tag_path | strip %}

                      {% if tag_path == blank %}
                        {% assign filter_url = collection.url %}
                      {% else %}
                        {% assign filter_url = collection.url | append: '/' | append: tag_path %}
                      {% endif %}

                      <li class="product-filters__list-item">

                        <a
                          href="{{ filter_url }}"
                          class="product-filters__tag-link{% if tag_is_active %} is-active active{% endif %}"
                          {% if tag_is_active %}aria-current="true"{% endif %}
                        >
                          <span class="product-filters__checkbox">
                            {% if tag_is_active %}
                              <span class="product-filters__checkbox-inner"></span>
                            {% endif %}
                          </span>

                          <span>{{ tag_label }}</span>
                        </a>

                      </li>

                    {% endif %}

                  {% endfor %}

                </ul>

              </div>
            </div>

          {% endif %}

        {% endfor %}

      {% endif %}

      {% comment %} ACTIVE FILTERS / CLEAR ALL {% endcomment %}
      {% if current_tags.size > 0 %}
        <div class="product-filters__active">

          <div class="product-filters__active-header">
            <strong>Selected filters</strong>
            <a href="{{ collection.url }}">Clear all</a>
          </div>

          <ul class="product-filters__active-list">
            {% for selected_tag in current_tags %}
              <li>
                {% assign selected_label = selected_tag | replace: '-', ' ' | capitalize %}
                <span>{{ selected_label }}</span>
              </li>
            {% endfor %}
          </ul>

        </div>
      {% endif %}

    </div>
  </div>
</div>
