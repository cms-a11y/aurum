{% comment %}
  Builds a WhatsApp link with product details.
  Accepts:
    - product
    - whatsapp_number
    - custom_message
{% endcomment %}
{%- liquid
	assign phone_number = whatsapp_number | default: '+255754 810 770' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '+', ''

	if product
		assign product_title = product.title
		assign product_url = shop.url | append: product.url
		assign product_price = product.price | money
		assign product_code = product.metafields.custom.product_code.value
	else
		assign product_title = 'Product'
		assign product_url = shop.url
		assign product_price = ''
		assign product_code = ''
	endif

	assign message_template = custom_message | default: "Hi, I'm interested in {product_title}. {product_url}"

	unless message_template contains '{product_code}'
		assign message_template = message_template | append: ' Product code: {product_code}'
	endunless

	assign custom_message_final = message_template | replace: '{product_title}', product_title | replace: '{product_url}', product_url | replace: '{product_price}', product_price | replace: '{product_code}', product_code
	assign encoded_message = custom_message_final | url_encode

	if phone_number != blank
		echo 'https://wa.me/' | append: phone_number | append: '?text=' | append: encoded_message
	else
		echo '#'
	endif
-%}
