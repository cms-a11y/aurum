
{% liquid
  assign sid = section.id
  assign overlay_opacity = section.settings.gradient_opacity | divided_by: 100.0

  assign heading_html = section.settings.heading | escape
  assign heading_html = heading_html | replace: '&lt;br/&gt;', '<br>'
  assign heading_html = heading_html | replace: '&lt;br /&gt;', '<br>'
  assign heading_html = heading_html | replace: '&lt;br&gt;', '<br>'
%}

{% style %}
  #QuoteBanner-{{ sid }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: {{ section.settings.desktop_height }}px;
    overflow: hidden;
    background-color: {{ section.settings.fallback_background }};
  }

  #QuoteBanner-{{ sid }} .quote-banner__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #QuoteBanner-{{ sid }} .quote-banner__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  #QuoteBanner-{{ sid }} .quote-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;

    {% if section.settings.enable_gradient %}
      background: linear-gradient(
        {{ section.settings.gradient_rotation }}deg,
        {{ section.settings.gradient_color_1 }} 0%,
        {{ section.settings.gradient_color_2 }} 50%,
        {{ section.settings.gradient_color_3 }} 100%
      );
      opacity: {{ overlay_opacity }};
    {% else %}
      background: transparent;
      opacity: 0;
    {% endif %}
  }

  #QuoteBanner-{{ sid }} .quote-banner__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.desktop_padding_top }}px {{ section.settings.desktop_padding_horizontal }}px {{ section.settings.desktop_padding_bottom }}px;
  }

  #QuoteBanner-{{ sid }} .quote-banner__content {
    width: {{ section.settings.content_width }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  /* Subtitle */

  #QuoteBanner-{{ sid }} .quote-banner__subtitle {
    margin: 0 0 {{ section.settings.subtitle_spacing }}px;
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.5;
    letter-spacing: {{ section.settings.subtitle_letter_spacing }}px;
    text-align: {{ section.settings.subtitle_alignment }};
    text-transform: {{ section.settings.subtitle_transform }};

    {% if section.settings.subtitle_italic %}
      font-style: italic;
    {% endif %}
  }

  /* Heading */

  #QuoteBanner-{{ sid }} .quote-banner__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: {{ section.settings.heading_line_height | divided_by: 10.0 }};
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-align: {{ section.settings.heading_alignment }};

    {% if section.settings.heading_italic %}
      font-style: italic;
    {% endif %}
  }

  /* Description */

  #QuoteBanner-{{ sid }} .quote-banner__description {
    margin: 0 0 {{ section.settings.description_spacing }}px;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_size }}px;
    line-height: {{ section.settings.description_line_height | divided_by: 10.0 }};
    text-align: {{ section.settings.description_alignment }};

    {% if section.settings.description_italic %}
      font-style: italic;
    {% endif %}
  }

  #QuoteBanner-{{ sid }} .quote-banner__description p {
    margin: 0 0 12px;
  }

  #QuoteBanner-{{ sid }} .quote-banner__description p:last-child {
    margin-bottom: 0;
  }

  /* Button */

  #QuoteBanner-{{ sid }} .quote-banner__button-wrapper {
    display: flex;
    justify-content: {{ section.settings.button_alignment }};
    margin-top: {{ section.settings.button_top_spacing }}px;
  }

  #QuoteBanner-{{ sid }} .quote-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: {{ section.settings.button_height }}px;
    padding: 12px 40px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_weight }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    text-transform: {{ section.settings.button_transform }};
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    border: {{ section.settings.button_border_width }}px solid;
    transition: all 0.3s ease;
    cursor: pointer;

    {% if section.settings.button_style == 'primary' %}
      color: {{ section.settings.primary_text }};
      background: {{ section.settings.primary_background }};
      border-color: {{ section.settings.primary_border }};
    {% else %}
      color: {{ section.settings.secondary_text }};
      background: {{ section.settings.secondary_background }};
      border-color: {{ section.settings.secondary_border }};
    {% endif %}
  }

  #QuoteBanner-{{ sid }} .quote-banner__button:hover {
    {% if section.settings.button_style == 'primary' %}
      color: {{ section.settings.primary_hover_text }};
      background: {{ section.settings.primary_hover_background }};
      border-color: {{ section.settings.primary_hover_border }};
    {% else %}
      color: {{ section.settings.secondary_hover_text }};
      background: {{ section.settings.secondary_hover_background }};
      border-color: {{ section.settings.secondary_hover_border }};
    {% endif %}
  }

  #QuoteBanner-{{ sid }} .quote-banner__button-arrow {
    font-size: 18px;
    line-height: 1;
  }

  /* Mobile */

  @media screen and (max-width: 749px) {
    #QuoteBanner-{{ sid }} {
      min-height: {{ section.settings.mobile_height }}px;
    }

    #QuoteBanner-{{ sid }} .quote-banner__background img {
      object-position: {{ section.settings.mobile_image_position }};
    }

    #QuoteBanner-{{ sid }} .quote-banner__container {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_horizontal }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    #QuoteBanner-{{ sid }} .quote-banner__content {
      width: {{ section.settings.mobile_content_width }}%;
    }

    #QuoteBanner-{{ sid }} .quote-banner__subtitle {
      font-size: {{ section.settings.mobile_subtitle_size }}px;
      text-align: {{ section.settings.mobile_subtitle_alignment }};
      margin-bottom: {{ section.settings.subtitle_spacing | divided_by: 2 }}px;
    }

    #QuoteBanner-{{ sid }} .quote-banner__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      text-align: {{ section.settings.mobile_heading_alignment }};
      margin-bottom: {{ section.settings.heading_spacing | divided_by: 2 }}px;
    }

    #QuoteBanner-{{ sid }} .quote-banner__description {
      font-size: {{ section.settings.mobile_description_size }}px;
      text-align: {{ section.settings.mobile_description_alignment }};
      margin-bottom: {{ section.settings.description_spacing | divided_by: 2 }}px;
    }

    #QuoteBanner-{{ sid }} .quote-banner__button-wrapper {
      justify-content: {{ section.settings.mobile_button_alignment }};
      margin-top: {{ section.settings.button_top_spacing | divided_by: 2 }}px;
    }

    #QuoteBanner-{{ sid }} .quote-banner__button {
      min-height: 44px;
      padding: 12px 24px;
      font-size: {{ section.settings.mobile_button_font_size }}px;
      max-width: 100%;
    }
  }
{% endstyle %}

<section
  id="QuoteBanner-{{ sid }}"
  class="quote-banner {{ section.settings.custom_class }}"
>
  {% if section.settings.background_image != blank or section.settings.mobile_background_image != blank %}
    <div class="quote-banner__background">
      <picture>
        {% if section.settings.mobile_background_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_background_image | image_url: width: 1200 }}"
          >
        {% endif %}

        {% if section.settings.background_image != blank %}
          <img
            src="{{ section.settings.background_image | image_url: width: 2400 }}"
            alt="{{ section.settings.background_image.alt | escape }}"
            width="{{ section.settings.background_image.width }}"
            height="{{ section.settings.background_image.height }}"
            loading="lazy"
          >
        {% elsif section.settings.mobile_background_image != blank %}
          <img
            src="{{ section.settings.mobile_background_image | image_url: width: 1200 }}"
            alt="{{ section.settings.mobile_background_image.alt | escape }}"
            width="{{ section.settings.mobile_background_image.width }}"
            height="{{ section.settings.mobile_background_image.height }}"
            loading="lazy"
          >
        {% endif %}
      </picture>
    </div>
  {% endif %}

  <div class="quote-banner__overlay"></div>

  <div class="quote-banner__container">
    <div class="quote-banner__content">

      {% if section.settings.subtitle != blank %}
        <div class="quote-banner__subtitle">
          {{ section.settings.subtitle | escape }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="quote-banner__heading">
          {{ heading_html }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="quote-banner__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="quote-banner__button-wrapper">
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="quote-banner__button"
          >
            {{ section.settings.button_label | escape }}

            {% if section.settings.show_arrow %}
              <span class="quote-banner__button-arrow" aria-hidden="true">→</span>
            {% endif %}
          </a>
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quote statement banner",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "color",
      "id": "fallback_background",
      "label": "Fallback background",
      "default": "#75162D"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "options": [
        {"value": "center center", "label": "Center"},
        {"value": "left center", "label": "Left"},
        {"value": "right center", "label": "Right"},
        {"value": "center top", "label": "Top"},
        {"value": "center bottom", "label": "Bottom"}
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        {"value": "center center", "label": "Center"},
        {"value": "left center", "label": "Left"},
        {"value": "right center", "label": "Right"},
        {"value": "center top", "label": "Top"},
        {"value": "center bottom", "label": "Bottom"}
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Gradient overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Enable gradient",
      "default": true
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient color 1",
      "default": "#75162D"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient color 2",
      "default": "#75162D"
    },
    {
      "type": "color",
      "id": "gradient_color_3",
      "label": "Gradient color 3",
      "default": "#35151C"
    },
    {
      "type": "range",
      "id": "gradient_rotation",
      "label": "Gradient rotation",
      "min": 0,
      "max": 360,
      "step": 10,
      "unit": "deg",
      "default": 90
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "label": "Gradient opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "header",
      "content": "Content layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container maximum width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Desktop content width",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "range",
      "id": "mobile_content_width",
      "label": "Mobile content width",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop minimum height",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile minimum height",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR HERITAGE"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Desktop font size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_subtitle_size",
      "label": "Mobile font size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "subtitle_italic",
      "label": "Italic subtitle",
      "default": false
    },
    {
      "type": "range",
      "id": "subtitle_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "select",
      "id": "subtitle_transform",
      "label": "Text transform",
      "options": [
        {"value": "uppercase", "label": "Uppercase"},
        {"value": "none", "label": "Normal"},
        {"value": "capitalize", "label": "Capitalize"}
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "subtitle_alignment",
      "label": "Desktop alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_subtitle_alignment",
      "label": "Mobile alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "subtitle_spacing",
      "label": "Space below subtitle",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We believe jewellery is more than an object – it is an heirloom in the making."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop font size",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile font size",
      "min": 22,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "heading_italic",
      "label": "Italic heading",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "options": [
        {"value": "400", "label": "Normal"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi bold"},
        {"value": "700", "label": "Bold"}
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 8,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -3,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Desktop alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_heading_alignment",
      "label": "Mobile alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Content",
      "default": "<p>Over 15 years of artisanal craft from the finest gemstones and precious metals, handpicked with love.</p>"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Content color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Desktop font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "label": "Mobile font size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "description_italic",
      "label": "Italic content",
      "default": false
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Content line height",
      "min": 10,
      "max": 25,
      "step": 1,
      "default": 18
    },
    {
      "type": "select",
      "id": "description_alignment",
      "label": "Desktop alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_description_alignment",
      "label": "Mobile alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "description_spacing",
      "label": "Space below content",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow",
      "default": false
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {"value": "primary", "label": "Primary"},
        {"value": "secondary", "label": "Secondary"}
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Primary button colors"
    },
    {
      "type": "color",
      "id": "primary_background",
      "label": "Background",
      "default": "#75162D"
    },
    {
      "type": "color",
      "id": "primary_text",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_border",
      "label": "Border",
      "default": "#75162D"
    },
    {
      "type": "color",
      "id": "primary_hover_background",
      "label": "Hover background",
      "default": "#4D0E20"
    },
    {
      "type": "color",
      "id": "primary_hover_text",
      "label": "Hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_hover_border",
      "label": "Hover border",
      "default": "#4D0E20"
    },
    {
      "type": "header",
      "content": "Secondary button colors"
    },
    {
      "type": "color",
      "id": "secondary_background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_text",
      "label": "Text",
      "default": "#75162D"
    },
    {
      "type": "color",
      "id": "secondary_border",
      "label": "Border",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_hover_background",
      "label": "Hover background",
      "default": "#75162D"
    },
    {
      "type": "color",
      "id": "secondary_hover_text",
      "label": "Hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_hover_border",
      "label": "Hover border",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Desktop font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_button_font_size",
      "label": "Mobile font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "button_weight",
      "label": "Font weight",
      "options": [
