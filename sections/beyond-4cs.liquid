
{% comment %}
  Section: Looking Beyond the 4Cs
  Centered editorial content with SVG icon, quote and CTA.
{% endcomment %}

<section
  id="beyond-4cs-{{ section.id }}"
  class="beyond-4cs-section {{ section.settings.custom_class }}"
  style="
    --b4c-bg: {{ section.settings.background_color }};
    --b4c-width: {{ section.settings.section_width }}px;
    --b4c-top: {{ section.settings.padding_top }}px;
    --b4c-bottom: {{ section.settings.padding_bottom }}px;
    --b4c-inner-bg: {{ section.settings.content_background }};
    --b4c-heading: {{ section.settings.heading_color }};
    --b4c-text: {{ section.settings.text_color }};
    --b4c-accent: {{ section.settings.accent_color }};
    --b4c-border: {{ section.settings.border_color }};
    --b4c-radius: {{ section.settings.border_radius }}px;
  "
>
  <div class="b4c-container">

    <div class="b4c-inner">

      {% if section.settings.show_icon and section.settings.icon_svg != blank %}
        <div class="b4c-icon">
          {{ section.settings.icon_svg }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="b4c-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.show_divider %}
        <span class="b4c-divider"></span>
      {% endif %}

      {% if section.settings.content != blank %}
        <div class="b4c-content rte">
          {{ section.settings.content }}
        </div>
      {% endif %}

      {% if section.settings.highlight_content != blank %}
        <div class="b4c-highlight rte">
          {{ section.settings.highlight_content }}
        </div>
      {% endif %}

      {% if section.settings.show_quote %}
        {% if section.settings.quote_text != blank %}
          <div class="b4c-quote">
            <div class="b4c-quote-line"></div>
            <div class="b4c-quote-text">
              {{ section.settings.quote_text }}
            </div>
          </div>
        {% endif %}
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="b4c-button-wrap">
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="b4c-button"
          >
            {{ section.settings.button_label }}
            {% if section.settings.show_button_arrow %}
              <span class="b4c-button-arrow" aria-hidden="true">→</span>
            {% endif %}
          </a>
        </div>
      {% endif %}

    </div>

  </div>
</section>

<style>
  #beyond-4cs-{{ section.id }} {
    width: 100%;
    padding-top: var(--b4c-top);
    padding-bottom: var(--b4c-bottom);
    background: var(--b4c-bg);
  }

  #beyond-4cs-{{ section.id }} *,
  #beyond-4cs-{{ section.id }} *::before,
  #beyond-4cs-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #beyond-4cs-{{ section.id }} .b4c-container {
    width: 100%;
    max-width: var(--b4c-width);
    padding: 0 20px;
    margin: 0 auto;
    border-radius: 6px;
  }

  #beyond-4cs-{{ section.id }} .b4c-inner {
    width: 100%;
    padding: {{ section.settings.inner_padding }}px;
    background: var(--b4c-inner-bg);
    border: {{ section.settings.border_width }}px solid var(--b4c-border);
    border-radius: var(--b4c-radius);
    text-align: center;
  }

  /* ICON */

  #beyond-4cs-{{ section.id }} .b4c-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto {{ section.settings.icon_spacing }}px;
    color: var(--b4c-accent);
    border: 1px solid var(--b4c-border);
    border-radius: 50%;
    padding: 9px;
  }

  #beyond-4cs-{{ section.id }} .b4c-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-width: 1.8;
  }

  /* HEADING */

  #beyond-4cs-{{ section.id }} .b4c-heading {
    color: var(--b4c-heading);
    font-family: var(--heading-font-family);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }

  #beyond-4cs-{{ section.id }} .b4c-divider {
    display: block;
    width: {{ section.settings.divider_width }}px;
    height: 2px;
    background: var(--b4c-accent);
    margin: {{ section.settings.divider_spacing }}px auto;
  }

  /* CONTENT */

  #beyond-4cs-{{ section.id }} .b4c-content {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    color: var(--b4c-text);
    font-size: {{ section.settings.content_size }}px;
    line-height: 1.8;
  }

  #beyond-4cs-{{ section.id }} .b4c-content p {
    margin: 0 0 {{ section.settings.paragraph_spacing }}px;
  }

  #beyond-4cs-{{ section.id }} .b4c-content p:last-child {
    margin-bottom: 0;
  }

  #beyond-4cs-{{ section.id }} .b4c-content strong {
    color: var(--b4c-heading);
    font-weight: 600;
  }

  /* HIGHLIGHT */

  #beyond-4cs-{{ section.id }} .b4c-highlight {
    max-width: {{ section.settings.content_width }}px;
    margin: {{ section.settings.highlight_spacing }}px auto 0;
    color: var(--b4c-accent);
    font-size: {{ section.settings.highlight_size }}px;
    font-weight: 600;
    line-height: 1.7;
  }

  #beyond-4cs-{{ section.id }} .b4c-highlight p {
    margin: 0;
  }

  /* QUOTE */

  #beyond-4cs-{{ section.id }} .b4c-quote {
    max-width: {{ section.settings.content_width }}px;
    margin: {{ section.settings.quote_spacing }}px auto 0;
    padding-top: {{ section.settings.quote_spacing }}px;
    border-top: 1px solid var(--b4c-border);
  }

  #beyond-4cs-{{ section.id }} .b4c-quote-line {
    display: none;
  }

  #beyond-4cs-{{ section.id }} .b4c-quote-text {
    color: var(--b4c-heading);
    font-family: var(--heading-font-family);
    font-size: {{ section.settings.quote_size }}px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.35;
  }

  /* BUTTON */

  #beyond-4cs-{{ section.id }} .b4c-button-wrap {
    margin-top: {{ section.settings.button_spacing }}px;
  }

  #beyond-4cs-{{ section.id }} .b4c-button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 32px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border: 1px solid {{ section.settings.button_background }};
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 600;
    letter-spacing: .13em;
    line-height: 1.4;
    text-decoration: none;
    text-align: center;
    transition: all .25s ease;
  }

  #beyond-4cs-{{ section.id }} .b4c-button:hover {
    background: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text }};
    border-color: {{ section.settings.button_hover_background }};
  }

  #beyond-4cs-{{ section.id }} .b4c-button-arrow {
    font-size: 16px;
    transition: transform .25s ease;
  }

  #beyond-4cs-{{ section.id }} .b4c-button:hover .b4c-button-arrow {
    transform: translateX(4px);
  }

  /* TABLET */

  @media screen and (max-width: 989px) {
    #beyond-4cs-{{ section.id }} .b4c-heading {
      font-size: {{ section.settings.tablet_heading_size }}px;
    }

    #beyond-4cs-{{ section.id }} .b4c-inner {
      padding: 40px 30px;
    }
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    #beyond-4cs-{{ section.id }} {
      padding-top: calc(var(--b4c-top) * .65);
      padding-bottom: calc(var(--b4c-bottom) * .65);
    }

    #beyond-4cs-{{ section.id }} .b4c-container {
      padding-left: 15px;
      padding-right: 15px;
    }

    #beyond-4cs-{{ section.id }} .b4c-inner {
      padding: {{ section.settings.mobile_inner_padding }}px 18px;
    }

    #beyond-4cs-{{ section.id }} .b4c-icon {
      width: {{ section.settings.mobile_icon_size }}px;
      height: {{ section.settings.mobile_icon_size }}px;
      margin-bottom: 20px;
    }

    #beyond-4cs-{{ section.id }} .b4c-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.2;
    }

    #beyond-4cs-{{ section.id }} .b4c-content {
      font-size: {{ section.settings.mobile_content_size }}px;
      line-height: 1.75;
    }

    #beyond-4cs-{{ section.id }} .b4c-content p {
      margin-bottom: 16px;
    }

    #beyond-4cs-{{ section.id }} .b4c-highlight {
      font-size: {{ section.settings.mobile_highlight_size }}px;
    }

    #beyond-4cs-{{ section.id }} .b4c-quote {
      margin-top: 25px;
      padding-top: 25px;
    }

    #beyond-4cs-{{ section.id }} .b4c-quote-text {
      font-size: {{ section.settings.mobile_quote_size }}px;
    }

    #beyond-4cs-{{ section.id }} .b4c-button-wrap {
      margin-top: 25px;
    }

    #beyond-4cs-{{ section.id }} .b4c-button {
      width: 100%;
      padding: 14px 16px;
      font-size: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Beyond the 4Cs",
  "tag": "section",
  "class": "section-beyond-4cs",
  "settings": [
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "textarea",
      "id": "icon_svg",
      "label": "SVG icon code",
      "info": "Paste your complete inline SVG code."
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Desktop icon size",
      "min": 30,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_icon_size",
      "label": "Mobile icon size",
      "min": 28,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Icon bottom spacing",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "header",
      "content": "Heading and content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Looking Beyond the 4Cs"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show title divider",
      "default": true
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider width",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 85
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Divider spacing",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Main content",
      "default": "<p>While grading provides a valuable way to understand Tanzanite, numbers and classifications tell only part of its story.</p><p>The beauty of Tanzanite lies in the way its qualities come together; the depth of its blue, flashes of violet, brilliance of its cut and the individual character that makes each gemstone different.</p>"
    },
    {
      "type": "richtext",
      "id": "highlight_content",
      "label": "Highlighted content",
      "default": "<p>Ultimately, the finest Tanzanite is not simply the one with the highest specifications. It is the one whose beauty captures you.</p>"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "checkbox",
      "id": "show_quote",
      "label": "Show quotation",
      "default": true
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text",
      "default": "“No two Tanzanites are the same. Find the one that feels like yours.”"
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "Desktop quote font size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "mobile_quote_size",
      "label": "Mobile quote font size",
      "min": 16,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "range",
      "id": "quote_spacing",
      "label": "Quote spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Inquire with our senior gemologist"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "Show button arrow",
      "default": false
    },
    {
      "type": "range",
      "id": "button_spacing",
      "label": "Button top spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#751522"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#55101B"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section width and spacing"
    },
   {
  "type": "range",
  "id": "section_width",
  "label": "Section maximum width",
  "min": 600,
  "max": 1600,
  "step": 10,
  "unit": "px",
  "default": 1500
},
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "inner_padding",
      "label": "Desktop inner padding",
      "min": 15,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_inner_padding",
      "label": "Mobile inner padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Container radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography sizes"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop title size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "tablet_heading_size",
      "label": "Tablet title size",
      "min": 26,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile title size",
      "min": 24,
      "max": 42,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content maximum width",
      "min": 300,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "content_size",
      "label": "Desktop content size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_content_size",
      "label": "Mobile content size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "highlight_size",
      "label": "Highlight font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_highlight_size",
      "label": "Mobile highlight font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Paragraph spacing",
      "min": 5,
      "max": 35,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "highlight_spacing",
      "label": "Highlight top spacing",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Inner background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#751522"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content colour",
      "default": "#352526"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#8A2939"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#EADDDD"
    },
    {
      "type": "header",
      "content": "Custom CSS"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom section class",
      "info": "Enter a class name without the dot."
    }
  ],
  "presets": [
    {
      "name": "Beyond the 4Cs"
    }
  ]
}
{% endschema %}
