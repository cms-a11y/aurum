
{% liquid
  assign section_id = section.id
  assign gradient_opacity = section.settings.gradient_opacity | divided_by: 100.0
  assign heading_text = section.settings.heading | escape

  assign heading_text = heading_text | replace: '&lt;br/&gt;', '<br>'
  assign heading_text = heading_text | replace: '&lt;br /&gt;', '<br>'
  assign heading_text = heading_text | replace: '&lt;br&gt;', '<br>'
%}

{% style %}
  #shopify-section-{{ section_id }} {
    position: relative;
  }

  #AppointmentBanner-{{ section_id }} {
    position: relative;
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    width: 100%;
    min-height: {{ section.settings.desktop_height }}px;
    overflow: hidden;
    background-color: {{ section.settings.fallback_background }};
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

#AppointmentBanner-{{ section_id }} .appointment-banner__gradient {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;

  {% if section.settings.enable_gradient and section.settings.gradient_opacity > 0 %}
    background: linear-gradient(
      {{ section.settings.gradient_rotation }}deg,
      {{ section.settings.gradient_color_1 }}{{ section.settings.gradient_opacity | times: 0.01 | times: 100 | round | prepend: '' }} 0%,
      {{ section.settings.gradient_color_2 }} 50%,
      {{ section.settings.gradient_color_3 }} 100%
    );
    opacity: {{ section.settings.gradient_opacity | divided_by: 100.0 }};
  {% else %}
    background: transparent;
    opacity: 0;
  {% endif %}
}

  #AppointmentBanner-{{ section_id }} .appointment-banner__container {
    position: relative;
    z-index: 2;
    display: flex;
    width: 100%;
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.desktop_padding_top }}px {{ section.settings.desktop_padding_horizontal }}px {{ section.settings.desktop_padding_bottom }}px;
    {% if section.settings.content_position == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__content {
    width: {{ section.settings.content_width }}%;
    max-width: 100%;
    color: {{ section.settings.text_color }};
    text-align: {{ section.settings.content_text_alignment }};
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__subtitle {
    display: block;
    margin: 0 0 {{ section.settings.subtitle_spacing }}px;
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.5;
    letter-spacing: {{ section.settings.subtitle_letter_spacing }}px;
    text-transform: {{ section.settings.subtitle_transform }};
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__description {
    margin: 0 0 {{ section.settings.description_spacing }}px;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_size }}px;
    line-height: {{ section.settings.description_line_height }};
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__description p {
    margin: 0 0 12px;
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__description p:last-child {
    margin-bottom: 0;
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__button-wrapper {
    display: flex;
    width: 100%;
    margin-bottom: {{ section.settings.button_spacing }}px;
    {% if section.settings.content_text_alignment == 'center' %}
      justify-content: center;
    {% elsif section.settings.content_text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 14px 38px;
    color: {% if section.settings.button_style == 'primary' %}{{ section.settings.primary_button_text }}{% else %}{{ section.settings.secondary_button_text }}{% endif %};
    background: {% if section.settings.button_style == 'primary' %}{{ section.settings.primary_button_background }}{% else %}transparent{% endif %};
    border: {{ section.settings.button_border_width }}px solid {% if section.settings.button_style == 'primary' %}{{ section.settings.primary_button_border }}{% else %}{{ section.settings.secondary_button_border }}{% endif %};
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_text_size }}px;
    font-weight: {{ section.settings.button_weight }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    text-decoration: none;
    text-transform: {{ section.settings.button_transform }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__button:hover {
    {% if section.settings.button_style == 'primary' %}
      background: {{ section.settings.primary_button_hover_background }};
      color: {{ section.settings.primary_button_hover_text }};
    {% else %}
      background: {{ section.settings.secondary_button_hover_background }};
      color: {{ section.settings.secondary_button_hover_text }};
    {% endif %}
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__after-content {
    color: {{ section.settings.after_content_color }};
    font-size: {{ section.settings.after_content_size }}px;
    line-height: 1.7;
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__after-content p {
    margin: 0 0 10px;
  }

  #AppointmentBanner-{{ section_id }} .appointment-banner__after-content p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    #AppointmentBanner-{{ section_id }} {
      min-height: {{ section.settings.mobile_height }}px;
      align-items: {{ section.settings.mobile_vertical_alignment }};
    }

    #AppointmentBanner-{{ section_id }} .appointment-banner__background img {
      object-position: {{ section.settings.mobile_image_position }};
    }

    #AppointmentBanner-{{ section_id }} .appointment-banner__container {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_horizontal }}px {{ section.settings.mobile_padding_bottom }}px;
      {% if section.settings.content_position == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    #AppointmentBanner-{{ section_id }} .appointment-banner__content {
      width: {{ section.settings.mobile_content_width }}%;
      text-align: {{ section.settings.mobile_content_alignment }};
    }

    #AppointmentBanner-{{ section_id }} .appointment-banner__subtitle {
      font-size: {{ section.settings.mobile_subtitle_size }}px;
      margin-bottom: {{ section.settings.subtitle_spacing | divided_by: 2 }}px;
    }

    #AppointmentBanner-{{ section_id }} .appointment-banner__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      margin-bottom: {{ section.settings.heading_spacing | divided_by: 2 }}px;
    }

    #AppointmentBanner-{{ section_id }} .appointment-banner__description {
      font-size: {{ section.settings.mobile_description_size }}px;
      margin-bottom: {{ section.settings.description_spacing | divided_by: 2 }}px;
    }

    #AppointmentBanner-{{ section_id }} .appointment-banner__button-wrapper {
      {% if section.settings.mobile_content_alignment == 'center' %}
        justify-content: center;
      {% elsif section.settings.mobile_content_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
      margin-bottom: {{ section.settings.button_spacing | divided_by: 2 }}px;
    }

    #AppointmentBanner-{{ section_id }} .appointment-banner__button {
      min-height: 46px;
      padding: 12px 22px;
      font-size: {{ section.settings.mobile_button_size }}px;
      max-width: 100%;
      text-align: center;
    }

    #AppointmentBanner-{{ section_id }} .appointment-banner__after-content {
      font-size: {{ section.settings.mobile_after_content_size }}px;
    }
  }
{% endstyle %}

<section
  id="AppointmentBanner-{{ section_id }}"
  class="appointment-banner {{ section.settings.custom_class }}"
>
  {% if section.settings.background_image != blank or section.settings.mobile_background_image != blank %}
    <div class="appointment-banner__background">
      <picture>
        {% if section.settings.mobile_background_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_background_image | image_url: width: 1200 }}"
          >
        {% endif %}

        {% if section.settings.background_image != blank %}
          <img
            src="{{ section.settings.background_image | image_url: width: 2400 }}"
            alt="{{ section.settings.background_image.alt | escape }}"
            width="{{ section.settings.background_image.width }}"
            height="{{ section.settings.background_image.height }}"
            loading="lazy"
          >
        {% elsif section.settings.mobile_background_image != blank %}
          <img
            src="{{ section.settings.mobile_background_image | image_url: width: 1200 }}"
            alt="{{ section.settings.mobile_background_image.alt | escape }}"
            width="{{ section.settings.mobile_background_image.width }}"
            height="{{ section.settings.mobile_background_image.height }}"
            loading="lazy"
          >
        {% endif %}
      </picture>
    </div>
  {% endif %}

  <div class="appointment-banner__gradient"></div>

  <div class="appointment-banner__container">
    <div class="appointment-banner__content">

      {% if section.settings.subtitle != blank %}
        <div class="appointment-banner__subtitle">
          {{ section.settings.subtitle | escape }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="appointment-banner__heading">
          {{ heading_text }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="appointment-banner__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="appointment-banner__button-wrapper">
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="appointment-banner__button"
            {% if section.settings.button_link == blank %}
              aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.button_label | escape }}

            {% if section.settings.show_button_arrow %}
              <span aria-hidden="true">⟶</span>
            {% endif %}
          </a>
        </div>
      {% endif %}

      {% if section.settings.after_content != blank %}
        <div class="appointment-banner__after-content">
          {{ section.settings.after_content }}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Appointment banner",
  "settings": [
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "color",
      "id": "fallback_background",
      "label": "Fallback background color",
      "default": "#35151C"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "options": [
        {"value": "center center", "label": "Center"},
        {"value": "left center", "label": "Left"},
        {"value": "right center", "label": "Right"},
        {"value": "center top", "label": "Top"},
        {"value": "center bottom", "label": "Bottom"}
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        {"value": "center center", "label": "Center"},
        {"value": "left center", "label": "Left"},
        {"value": "right center", "label": "Right"},
        {"value": "center top", "label": "Top"},
        {"value": "center bottom", "label": "Bottom"}
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Gradient overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Enable gradient",
      "default": true
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient color 1",
      "default": "#75162D"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient color 2",
      "default": "#35151C"
    },
    {
      "type": "color",
      "id": "gradient_color_3",
      "label": "Gradient color 3",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "gradient_rotation",
      "label": "Gradient rotation",
      "min": 0,
      "max": 360,
      "step": 10,
      "unit": "deg",
      "default": 90
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "label": "Gradient opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "header",
      "content": "Content column layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content column position",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "right", "label": "Right"}
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Desktop content width",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "content_text_alignment",
      "label": "Desktop text alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Content container max width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Desktop vertical alignment",
      "options": [
        {"value": "flex-start", "label": "Top"},
        {"value": "center", "label": "Center"},
        {"value": "flex-end", "label": "Bottom"}
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop minimum height",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 800
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "YOUR PRIVATE APPOINTMENT"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle font size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_subtitle_size",
      "label": "Mobile subtitle size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "subtitle_letter_spacing",
      "label": "Subtitle letter spacing",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "select",
      "id": "subtitle_transform",
      "label": "Subtitle text transform",
      "options": [
        {"value": "uppercase", "label": "Uppercase"},
        {"value": "none", "label": "Normal"},
        {"value": "capitalize", "label": "Capitalize"}
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "subtitle_spacing",
      "label": "Space below subtitle",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your story.<br/>Our undivided<br/>attention."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop heading size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "options": [
        {"value": "400", "label": "Normal"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi bold"},
        {"value": "700", "label": "Bold"}
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 0.8,
      "max": 1.8,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -3,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Tell us what you are drawn to, and what it means to you. A private appointment is a place to compare, ask questions, and find clarity.</p>"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Desktop description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "label": "Mobile description size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Description line height",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.9
    },
    {
      "type": "range",
      "id": "description_spacing",
      "label": "Space below description",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "REQUEST A PRIVATE APPOINTMENT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "Show arrow",
      "default": true
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {"value": "primary", "label": "Primary"},
        {"value": "secondary", "label": "Secondary"}
      ],
      "default": "secondary"
    },
    {
      "type": "color",
      "id": "primary_button_background",
      "label": "Primary background",
      "default": "#75162D"
    },
    {
      "type": "color",
      "id": "primary_button_text",
      "label": "Primary text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_button_border",
      "label": "Primary border",
      "default": "#75162D"
    },
    {
      "type": "color",
      "id": "primary_button_hover_background",
      "label": "Primary hover background",
      "default": "#35151C"
    },
    {
      "type": "color",
      "id": "primary_button_hover_text",
      "label": "Primary hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_button_text",
      "label": "Secondary text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_button_border",
      "label": "Secondary border",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_button_hover_background",
      "label": "Secondary hover background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_button_hover_text",
      "label": "Secondary hover text",
      "default": "#75162D"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Desktop button font size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_button_size",
      "label": "Mobile button font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "button_weight",
      "label": "Button font weight",
      "options": [
        {"value": "400", "label": "Normal"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi bold"},
        {"value": "700", "label": "Bold"}
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "button_letter_spacing",
      "label": "Button letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
