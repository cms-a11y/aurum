
{% comment %}
  Section: Product Related Products
  Supports:
  - Same collection
  - Shared product tags
  - Custom collection
  - Existing theme product-card snippet
{% endcomment %}

{%- render 'adastra' with '/src/styles/featured-products.scss' -%}

{%- liquid
  assign related_collection = section.settings.source_collection

  if related_collection == blank
    assign related_collection = product.collections.first
  endif

  assign related_count = 0
  assign products_limit = section.settings.products_limit
-%}

{% if request.page_type == 'product' and product != blank and related_collection != blank %}

  {%- comment -%} Count matching products first {%- endcomment -%}

  {% for candidate in related_collection.products limit: 50 %}
    {% if candidate.id != product.id %}

      {% assign show_candidate = false %}

      {% if section.settings.source_mode == 'tag_match' %}

        {% for candidate_tag in candidate.tags %}
          {% if product.tags contains candidate_tag %}
            {% assign show_candidate = true %}
            {% break %}
          {% endif %}
        {% endfor %}

      {% else %}
        {% assign show_candidate = true %}
      {% endif %}

      {% if show_candidate %}
        {% assign related_count = related_count | plus: 1 %}
        {% if related_count >= products_limit %}
          {% break %}
        {% endif %}
      {% endif %}

    {% endif %}
  {% endfor %}

  {% if related_count > 0 %}

    {% style %}
      #shopify-section-{{ section.id }} {
        background-color: {{ section.settings.background_color }};
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      #shopify-section-{{ section.id }} .related-products__container {
        width: 100%;
        max-width: {{ section.settings.container_width }};
        margin: 0 auto;
        padding-left: 20px;
        padding-right: 20px;
      }

      #shopify-section-{{ section.id }} .related-products__header {
        text-align: {{ section.settings.heading_alignment }};
        margin-bottom: {{ section.settings.heading_spacing }}px;
      }

      #shopify-section-{{ section.id }} .related-products__subtitle {
        color: {{ section.settings.subtitle_color }};
        font-size: {{ section.settings.subtitle_size_mobile }}px;
        margin: 0 0 8px;
        letter-spacing: 2px;
      }

      #shopify-section-{{ section.id }} .related-products__heading {
        color: {{ section.settings.heading_color }};
        font-size: {{ section.settings.heading_size_mobile }}px;
        line-height: 1.2;
        margin: 0;
      }

      #shopify-section-{{ section.id }} .related-products__grid {
        display: grid;
        grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
        gap: {{ section.settings.mobile_gap }}px;
      }

      #shopify-section-{{ section.id }} .related-products__item {
        min-width: 0;
      }

      @media screen and (min-width: 768px) {
        #shopify-section-{{ section.id }} {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        }

        #shopify-section-{{ section.id }} .related-products__container {
          padding-left: 30px;
          padding-right: 30px;
        }

        #shopify-section-{{ section.id }} .related-products__subtitle {
          font-size: {{ section.settings.subtitle_size_desktop }}px;
        }

        #shopify-section-{{ section.id }} .related-products__heading {
          font-size: {{ section.settings.heading_size_desktop }}px;
        }

        #shopify-section-{{ section.id }} .related-products__grid {
          grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
          gap: {{ section.settings.desktop_gap }}px;
        }
      }
    {% endstyle %}

    <section
      id="RelatedProducts-{{ section.id }}"
      class="related-products {{ section.settings.custom_class | escape }}"
    >
      <div class="related-products__container">

        {% if section.settings.subtitle != blank or section.settings.heading != blank %}
          <div class="related-products__header">

            {% if section.settings.subtitle != blank %}
              <p class="related-products__subtitle">
                {{ section.settings.subtitle | escape }}
              </p>
            {% endif %}

            {% if section.settings.heading != blank %}
              <h2 class="related-products__heading">
                {{ section.settings.heading | escape }}
              </h2>
            {% endif %}

          </div>
        {% endif %}

        <div class="related-products__grid">

          {% assign displayed_count = 0 %}

          {% for candidate in related_collection.products limit: 50 %}

            {% if candidate.id != product.id %}

              {% assign show_candidate = false %}

              {% if section.settings.source_mode == 'tag_match' %}

                {% for candidate_tag in candidate.tags %}
                  {% if product.tags contains candidate_tag %}
                    {% assign show_candidate = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}

              {% else %}
                {% assign show_candidate = true %}
              {% endif %}

              {% if show_candidate %}

                <div class="related-products__item featured-products__col">
                  {% render 'product-card',
                    product: candidate,
                    size: 640,
                    tablet_size: 382,
                    mobile_size: 333,
                    is_lazy: true
                  %}
                </div>

                {% assign displayed_count = displayed_count | plus: 1 %}

                {% if displayed_count >= products_limit %}
                  {% break %}
                {% endif %}

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>

      </div>
    </section>

  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Product related products",
  "tag": "section",
  "class": "product-related-products-section",
  "settings": [
    {
      "type": "header",
      "content": "Product source"
    },
    {
      "type": "select",
      "id": "source_mode",
      "label": "Related product method",
      "options": [
        {
          "value": "same_collection",
          "label": "Same collection"
        },
        {
          "value": "tag_match",
          "label": "Match product tags"
        },
        {
          "value": "custom_collection",
          "label": "Custom collection"
        }
      ],
      "default": "same_collection"
    },
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Select collection",
      "info": "Optional. If empty, the first collection assigned to the current product is used."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "DISCOVER MORE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "You May Also Like"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#98745C"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title color",
      "default": "#5C1728"
    },
    {
      "type": "range",
      "id": "subtitle_size_desktop",
      "label": "Subtitle desktop size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Subtitle mobile size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Title desktop size",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Title mobile size",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop column gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile column gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "1200px",
          "label": "1200px"
        },
        {
          "value": "1400px",
          "label": "1400px"
        },
        {
          "value": "1600px",
          "label": "1600px"
        },
        {
          "value": "100%",
          "label": "Full width"
        }
      ],
      "default": "1400px"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Product related products"
    }
  ]
}
{% endschema %}
