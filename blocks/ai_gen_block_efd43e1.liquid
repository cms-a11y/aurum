{% doc %}
  @prompt
    create a section for collection grid of 2*2 image with link
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
  }

  .ai-collection-grid-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-grid-{{ ai_gen_id }}__card {
    position: relative;
    display: block;
    overflow: hidden;
    color: {{ block.settings.text_color }};
    background: #f6f6f6;
    text-decoration: none;
    aspect-ratio: {{ block.settings.image_ratio }};
  }

  .ai-collection-grid-{{ ai_gen_id }}__image,
  .ai-collection-grid-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-collection-grid-{{ ai_gen_id }}__image {
    object-fit: cover;
  }

  .ai-collection-grid-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-grid-{{ ai_gen_id }}__placeholder {
    position: relative;
    background: #f6f6f6;
  }

  .ai-collection-grid-{{ ai_gen_id }}__empty {
    position: absolute;
    inset: auto 12px 12px;
    padding: 8px 10px;
    color: #161e13;
    background: rgba(255, 255, 255, 0.94);
    font-size: 13px;
    text-align: center;
  }

  .ai-collection-grid-{{ ai_gen_id }}__label {
    position: absolute;
    inset: auto 0 0;
    padding: 16px 18px;
    color: {{ block.settings.text_color }};
    background: rgba(22, 30, 19, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    font-size: {{ block.settings.label_size }}px;
    line-height: 1.3;
    text-align: {{ block.settings.text_alignment }};
    overflow-wrap: anywhere;
  }

  .ai-collection-grid-{{ ai_gen_id }}__card:focus-visible {
    outline: 3px solid #161e13;
    outline-offset: 3px;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-collection-grid-{{ ai_gen_id }}__grid {
      gap: {{ block.settings.grid_gap | divided_by: 2 }}px;
    }

    .ai-collection-grid-{{ ai_gen_id }}__label {
      padding: 10px;
      font-size: {{ block.settings.label_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid-{{ ai_gen_id }}__grid">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        assign link_key = 'link_' | append: i
        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign link = block.settings[link_key]
      %}
      {% if link != blank %}
        <a class="ai-collection-grid-{{ ai_gen_id }}__card" href="{{ link }}" aria-label="{{ title | default: 'View collection' | escape }}">
      {% else %}
        <div class="ai-collection-grid-{{ ai_gen_id }}__card">
      {% endif %}
        {% if image != blank %}
          <img class="ai-collection-grid-{{ ai_gen_id }}__image" src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: title | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
        {% else %}
          <div class="ai-collection-grid-{{ ai_gen_id }}__placeholder">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
            <span class="ai-collection-grid-{{ ai_gen_id }}__empty">Add an image for this tile</span>
          </div>
        {% endif %}
        {% if title != blank %}
          <span class="ai-collection-grid-{{ ai_gen_id }}__label">{{ title | escape }}</span>
        {% endif %}
      {% if link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection image grid",
  "settings": [
    { "type": "header", "content": "Grid layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "grid_gap", "label": "Gap", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 3", "label": "Landscape" }, { "value": "3 / 4", "label": "Portrait" } ], "default": "1 / 1" },
    { "type": "header", "content": "Tile appearance" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 100, "step": 10, "unit": "%", "default": 60 },
    { "type": "range", "id": "label_size", "label": "Label size", "min": 12, "max": 36, "step": 2, "unit": "px", "default": 20 },
    { "type": "select", "id": "text_alignment", "label": "Label alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "header", "content": "Tile 1" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "title_1", "label": "Label", "default": "Collection one" },
    { "type": "url", "id": "link_1", "label": "Link" },
    { "type": "header", "content": "Tile 2" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "title_2", "label": "Label", "default": "Collection two" },
    { "type": "url", "id": "link_2", "label": "Link" },
    { "type": "header", "content": "Tile 3" },
    { "type": "image_picker", "id": "image_3", "label": "Image" },
    { "type": "text", "id": "title_3", "label": "Label", "default": "Collection three" },
    { "type": "url", "id": "link_3", "label": "Link" },
    { "type": "header", "content": "Tile 4" },
    { "type": "image_picker", "id": "image_4", "label": "Image" },
    { "type": "text", "id": "title_4", "label": "Label", "default": "Collection four" },
    { "type": "url", "id": "link_4", "label": "Link" }
  ],
  "presets": [ { "name": "Collection image grid" } ],
  "tag": null,
  "class": "collection-image-grid-block"
}
{% endschema %}