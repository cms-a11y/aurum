{% doc %}
  @prompt
    We also need to have request quote and book a private viewing which will redirect to WhatsApp, i want only one button and make it such that i can add below atc button and create it such that i will add number  and it will open the whatsapp, make it such that i can add it below add to cart button so adjust width and height
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- capture whatsapp_link -%}
	{%- render 'whatsapp-link',
		product: product,
		whatsapp_number: block.settings.whatsapp_number,
		custom_message: block.settings.custom_message
	-%}
{%- endcapture -%}
{%- assign whatsapp_link = whatsapp_link | strip -%}

{% style %}
  .ai-whatsapp-button-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    margin-top: {{ block.settings.top_spacing }}px;
  }

  .ai-whatsapp-button__link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    transition: all 0.3s ease;
    cursor: pointer;
    width: 100%;
    min-height: 48px;
  }

  .ai-whatsapp-button__link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-whatsapp-button__icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-whatsapp-button__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
{% endstyle %}

<whatsapp-button-{{ ai_gen_id }}
  class="ai-whatsapp-button-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <a
    href="{{ whatsapp_link }}"
    class="ai-whatsapp-button__link-{{ ai_gen_id }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contact us on WhatsApp"
  >
    {% if block.settings.show_icon %}
      <span class="ai-whatsapp-button__icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
      </span>
    {% endif %}
    <span>{{ block.settings.button_text }}</span>
  </a>
</whatsapp-button-{{ ai_gen_id }}>

<script>
  (function() {
    class WhatsAppButton{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-whatsapp-button__link-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.button) {
          this.button.addEventListener('click', function(event) {
            const href = this.getAttribute('href');
            if (!href || href === '' || href === '#') {
              event.preventDefault();
              alert('Please add your WhatsApp number in the block settings');
            }
          });
        }
      }
    }

    customElements.define('whatsapp-button-{{ ai_gen_id }}', WhatsAppButton{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "WhatsApp button",
  "settings": [
    {
      "type": "header",
      "content": "WhatsApp settings"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "Enter with country code (e.g., 255123456789)"
    },
    {
      "type": "textarea",
      "id": "custom_message",
      "label": "Message template",
      "default": "Hi, I'm interested in {product_title}. {product_url} , {product_code}",
      "info": "Use {product_title}, {product_url}, {product_price}, {product_code} as placeholders"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Contact on WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show WhatsApp icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Top spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Background",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Hover background",
      "default": "#128C7E"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Hover border",
      "default": "#128C7E"
    }
  ],
  "presets": [
    {
      "name": "WhatsApp button"
    }
  ]
}
{% endschema %}
